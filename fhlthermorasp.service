[Unit]
Description=fhlthermorasp daemon
After=mnt-USBPi.mount

[Service]
ExecStart=/usr/bin/python3 -u /home/pi/Software/fhlthermorasp/service_sensor_monitor.py --bme680 --dir=/mnt/USBPi/Measurements/
WorkingDirectory=/home/pi/Software/fhlthermorasp
StandardOutput=inherit
StandardError=inherit
Restart=always
User=pi

[Install]
WantedBy=multi-user.target
